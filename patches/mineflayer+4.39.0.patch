+  // Taking a crafting result uses up one of each ingredient in the grid, and the
+  // vanilla client reports those grid slots along with the click. acceptClick
+  // knows nothing about recipes, so without this the click claims the grid is
+  // unchanged. The server then corrects each grid slot, and a correction that
+  // arrives after the next craft has put its ingredients down erases them from
+  // the client's model: the clicks that follow act on items that aren't there.
+  function takeCraftingIngredients (window, click, resultCount) {
+    const gridSize = window.type === 'minecraft:inventory' ? 4 : window.type === 'minecraft:crafting' ? 9 : 0
+    if (!gridSize || click.slot !== window.craftingResultSlot || !resultCount) return []
+    if ((window.slots[click.slot]?.count ?? 0) >= resultCount) return [] // the result wasn't taken
+    const changed = []
+    for (let slot = click.slot + 1; slot <= click.slot + gridSize; slot++) {
+      const item = window.slots[slot]
+      if (!item) continue
+      let left = null
+      if (item.count > 1) {
+        left = Item.fromNotch(Item.toNotch(item))
+        left.count = item.count - 1
+      }
+      window.updateSlot(slot, left)
+      changed.push(slot)
+    }
+    return changed
+  }
